      }
    },
    {
      "id": "licence",
      "text": "Must portal users work without their own BC licence?",
      "multi": false,
      "options": [
        {
          "label": "Yes, no BC licence for portal users",
          "patterns": [
            "without a bc licen",
            "no (additional )?bc (user )?licen",
